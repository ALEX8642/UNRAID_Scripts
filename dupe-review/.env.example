# Copy this file to .env (same directory) and fill in real values. .env is gitignored —
# never commit real credentials.

RADARR_URL=http://localhost:7878
RADARR_KEY=CHANGE_ME
SONARR_URL=http://localhost:8989
SONARR_KEY=CHANGE_ME
QBIT_URL=http://localhost:8080
QBIT_USER=admin
QBIT_PASS=CHANGE_ME

# Optional — enables automatic Plex library refresh + Empty Trash at the end of a session that
# deleted anything. Find yours: Plex Settings -> Account, or PlexOnlineToken in Preferences.xml.
# Leave blank to just get a manual reminder instead.
PLEX_URL=http://localhost:32400
PLEX_TOKEN=
